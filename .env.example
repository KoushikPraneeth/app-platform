# ==============================================================================
# Cloud-Native GitOps Platform - Environment Configuration Template
# ==============================================================================

# Core API Database and Cache Settings
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/platform_db
REDIS_URL=redis://redis:6379/0
NOTIFY_SERVICE_URL=http://notify-service:8001
CORS_ORIGINS=*

# PostgreSQL Container Defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platform_db

# Web Client Configuration (Accessed from Host Browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
